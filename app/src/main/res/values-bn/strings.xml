    <string name="info_alerts_heading">অর্ডারের অ্যালার্ট শীঘ্রই আসছে</string><string name="info_alerts_body">পুশ নোটিফিকেশন যোগ হলে, আপনার অর্ডার পিকআপের জন্য প্রস্তুত হওয়ামাত্র এখানে একটি বার্তা পাবেন। ততদিন পর্যন্ত, অর্ডার অনুসরণ করতে অর্ডার ট্যাব বা হোমের সক্রিয় অর্ডার কার্ডটি খুলুন।</string>
    <string name="info_pickup_heading">পিকআপ কীভাবে কাজ করে?</string><string name="info_pickup_body">আপনার পান বেছে নিন, অ্যাপে পেমেন্ট করুন এবং আপনার টোকেন নম্বরটি মনে রাখুন। অর্ডার তৈরি হয়ে গেলে আমরা “পিকআপের জন্য প্রস্তুত” দেখাব। অর্ডার নিতে কাউন্টারে আপনার টোকেন দেখান।</string>
    <string name="info_delivery_heading">ডেলিভারি কি পাওয়া যায়?</string><string name="info_delivery_body">না। এই অ্যাপ শুধুমাত্র দোকান থেকে পিকআপের জন্য।</string>
    <string name="info_cancel_heading">আমি কি অর্ডার বাতিল বা বদলাতে পারব?</string><string name="info_cancel_body">প্রতিটি পান আপনার অর্ডারের পরে টাটকা তৈরি হয়, তাই অ্যাপে অর্ডার বাতিল বা বদলানো যায় না। সাহায্য লাগলে অনুগ্রহ করে কাউন্টারের কর্মীদের সঙ্গে কথা বলুন বা দোকানে ফোন করুন।</string>
    <string name="info_time_heading">আমার অর্ডার হতে কত সময় লাগবে?</string><string name="info_time_body">প্রতিটি পণ্যের পেজে তৈরির আনুমানিক সময় দেখানো থাকে। আপনি অর্ডার ট্যাব থেকে লাইভ অর্ডার অনুসরণ করতে পারেন।</string>
    <string name="info_payment_heading">আমার পেমেন্টে সমস্যা হয়েছে</string><string name="info_payment_body">যদি টাকা কেটে নেওয়া হয়ে থাকে কিন্তু আপনি কোনো অর্ডার দেখতে না পান, তাহলে অনুগ্রহ করে আপনার ফোন নম্বর জানিয়ে দোকানের কাউন্টারে ফোন করুন, যাতে আমরা সাহায্য করতে পারি।</string>
    <string name="info_terms_heading">পরিষেবার শর্তাবলি</string><string name="info_terms_body">অ্যাপ প্রকাশের আগে এখানে আপনার পরিষেবার শর্তাবলি যোগ করুন।</string>
    <string name="info_privacy_heading">গোপনীয়তা নীতি</string><string name="info_privacy_body">অ্যাপ প্রকাশের আগে এখানে আপনার গোপনীয়তা নীতি যোগ করুন। আপনি কী কী তথ্য সংগ্রহ করেন (মোবাইল নম্বর, নাম, অর্ডারের ইতিহাস) এবং কেন, তা বর্ণনা করুন।</string>
